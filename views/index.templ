package views

import db "reportandil/db/sqlc"

templ IndexPage(reportes []db.Reporte, categorias []db.Categorium) {
	@Layout("Reportandil - Inicio") {
		<section class="reports-hero">
			<h3>Reportes Ciudadanos</h3>
			<p>Explora las últimas novedades e incidencias registradas en Tandil.</p>
		</section>
		<div class="home-layout">
			@ReporteForm(categorias)
			@ReporteList(reportes)
		</div>
	}
}
