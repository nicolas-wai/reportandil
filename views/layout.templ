package views

templ Layout(titulo string, username string) {
	<!DOCTYPE html>
	<html lang="es" >
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ titulo }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<link rel="stylesheet" href="/static/styles.css"/>
		</head>
		<body>
			<header class="container app-header">
				<nav>
					<ul>
						<li><h1 class="brand-title"><a href="/">Reportandil</a></h1></li>
					</ul>
					<ul>
						<li><span>Bienvenido, <strong>{ username }</strong></span></li>
						<li title="Nuevo Reporte">
							<a href="/#nuevo-reporte" role="button" class="contrast outline" aria-label="Nuevo reporte" style="display: inline-flex; align-items: center; gap: 0.4rem;">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 20h9"></path>
									<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
								</svg>
							</a>
						</li>
					</ul>
				</nav>
			</header>

			<main class="container">
				{ children... }
			</main>

			<footer class="app-footer">
				<div class="container">
					<nav>
						<ul>
							<li>
								<strong style="color: var(--pico-primary);">Reportandil</strong>
								<br/>
								<small>Gestión y seguimiento ágil de reportes</small>
							</li>
						</ul>
						<ul>
							<li><a href="/"><small>Inicio</small></a></li>
							<li><a href="/#nuevo-reporte"><small>Nuevo reporte</small></a></li>
						</ul>
					</nav>
				</div>
			</footer>

		</body>
	</html>
}