package views

templ Layout(titulo string, username string) {
	<!DOCTYPE html>
	<html lang="es" >
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<link rel="icon" href="https://github.com/nicolas-wai/reportandil/blob/main/static/faviconReportandil.png"/>
			<title>{ titulo }</title>
			<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.min.css"/>
			<style>
				:root {
				/* Color principal / énfasis (Azul Marino) */
				--pico-primary: #042a4f;
				--pico-primary-background: #042a4f;
				--pico-primary-hover: #073b6e;
				--pico-primary-border: #042a4f;
				--pico-primary-underline: rgba(4, 42, 79, 0.4);

				/* Color secundario / detalle (Coral/Rojo) */
				--brand-secondary: #f55147;
				--brand-secondary-hover: #db3f35;
				}

				body {
				min-height: 100vh;
				display: flex;
				flex-direction: column;
				margin: 0;
				}

				/* El elemento principal empuja el footer hacia el final de la pantalla */
				main {
				flex: 1;
				}

				/* Header estilizado */
				header.app-header {
				border-bottom: 2px solid var(--pico-primary);
				padding-top: 1rem;
				padding-bottom: 1rem;
				margin-bottom: 2rem;
				background-color: var(--pico-background-color);
				}

				header.app-header .brand-title {
				color: var(--pico-primary);
				font-weight: 800;
				letter-spacing: -0.5px;
				}

				.app-header a {
				text-decoration: none;
				}

				/* Botón de acción destacado con el color secundario */
				.btn-accent {
				background-color: var(--brand-secondary) !important;
				border-color: var(--brand-secondary) !important;
				color: #ffffff !important;
				transition: background-color 0.2s ease;
				}

				.btn-accent:hover {
				background-color: var(--brand-secondary-hover) !important;
				border-color: var(--brand-secondary-hover) !important;
				}

				/* Footer estilizado */
				footer.app-footer {
				border-top: 3px solid var(--pico-primary);
				background: var(--pico-card-background-color);
				padding-top: 2rem;
				padding-bottom: 2.5rem;
				margin-top: 4rem;
				}

				footer.app-footer small {
				color: var(--pico-muted-color);
				}

				footer.app-footer a {
				color: var(--pico-primary);
				text-decoration: none;
				}

				footer.app-footer a:hover {
				color: var(--brand-secondary);
				text-decoration: underline;
				}

				.footer-badge {
				background-color: var(--brand-secondary);
				color: #fff;
				padding: 0.15rem 0.5rem;
				border-radius: 4px;
				font-size: 0.75rem;
				font-weight: bold;
				}

				/* Estilos tipo Diario Digital para el Reporte */
				.report-article {
				width: 100%;
				margin: 0 auto;
				padding: 2.5rem 2rem;
				}

				.report-header {
				border-bottom: 1px solid var(--pico-border-color);
				padding-bottom: 1.5rem;
				margin-bottom: 2rem;
				}

				.report-badge-container {
				margin-bottom: 0.75rem;
				display: flex;
				gap: 0.5rem;
				align-items: center;
				}

				.report-badge {
				background-color: var(--pico-primary);
				color: #ffffff;
				text-transform: uppercase;
				font-size: 0.75rem;
				letter-spacing: 0.5px;
				padding: 0.2rem 0.5rem;
				}

				.report-title {
				font-size: 2.3rem;
				font-weight: 800;
				line-height: 1.2;
				margin-bottom: 1rem;
				color: var(--pico-color);
				}

				.report-meta-info {
				font-size: 0.875rem;
				color: var(--pico-muted-color);
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-wrap: wrap;
				}

				.report-figure {
				margin-bottom: 2.5rem;
				}

				.report-image {
				width: 100%;
				max-height: 450px;
				object-fit: cover;
				border-radius: 8px;
				box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
				}

				.report-caption {
				text-align: center;
				margin-top: 0.6rem;
				font-size: 0.85rem;
				color: var(--pico-muted-color);
				}

				.report-body {
				font-size: 1.125rem;
				line-height: 1.8;
				color: var(--pico-color);
				}

				.report-lead-paragraph {
				font-size: 1.25rem;
				font-weight: 500;
				line-height: 1.6;
				color: var(--pico-color);
				margin-bottom: 1.75rem;
				}

				.report-body p {
				margin-bottom: 1.5rem;
				}

				.report-divider {
				margin-top: 3rem;
				margin-bottom: 1.5rem;
				}

				.report-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				background: none;
				padding: 0;
				border: none;
				}

				.btn-auto-width {
				width: auto;
				font-size: 0.875rem;
				padding: 0.4rem 1rem;
				}
			</style>
		</head>
		<body>

			<header class="container app-header">
				<nav>
					<ul>
						<li><h1 class="brand-title"><a href="/">Reportandil</a></h1></li>
					</ul>
					<ul>
						<li><span>Bienvenido, <strong>{ username }</strong></span></li>
						<li title="Nuevo Reporte">
							<a href="/reportes/nuevo" role="button" class="contrast outline" style="display: inline-flex; align-items: center; gap: 0.4rem;">
								<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
									<path d="M12 20h9"></path>
									<path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path>
								</svg>
							</a>
						</li>
					</ul>
				</nav>
			</header>

			<main class="container">
				{ children... }
			</main>

			<footer class="app-footer">
				<div class="container">
					<nav>
						<ul>
							<li>
								<strong style="color: var(--pico-primary);">Reportandil</strong> 
								<span class="footer-badge">v1.0</span>
								<br/>
								<small>Gestión y seguimiento ágil de reportes</small>
							</li>
						</ul>
						<ul>
							<li><a href="/"><small>Inicio</small></a></li>
							<li><a href="/reportes/nuevo"><small>Nuevo reporte</small></a></li>
							<li><a href="/ayuda"><small>Ayuda</small></a></li>
						</ul>
					</nav>
				</div>
			</footer>

		</body>
	</html>
}