package views

import (
	db "reportandil/db/sqlc"
	"fmt"
)

templ ReporteList(reportes []db.Reporte) {
	<article>
		<h2>Reportes</h2>
		if len(reportes) == 0 {
			<p>Todavía no hay reportes</p>
		} else {
			<table>
				<thead>
					<tr>
						<th>ID</th>
						<th>Título</th>
						<th>Descripción</th>
						<th>Imagen</th>
						<th>Estado</th>
					</tr>
				</thead>
				<tbody>
					for _, rep := range reportes {
						<tr>
							<td>{ fmt.Sprint(rep.ID) }</td>
							<td>{ rep.Titulo }</td>
							<td>{ rep.Descripcion.String }</td>
							<td>{ rep.Imagen.String}</td>
							<td>{ rep.Estado }</td>
						</tr>
					}
				</tbody>
			</table>
		}
	</article>
}