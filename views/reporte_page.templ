package views

import (
	db "reportandil/db/sqlc"
	"strings"
	"strconv"
)

templ ReportCard(reporte db.Reporte) {
	<article class="report-article">
		
		<nav aria-label="breadcrumb">
			<ul>
				<li><a href="/" class="secondary"><small>Volver a reportes</small></a></li>
				<li><small>Reporte #{ strconv.Itoa(int(reporte.ID)) }</small></li>
			</ul>
		</nav>

		<header class="report-header">
			<div class="report-badge-container">
				<kbd class="report-badge">Reporte Ciudadano</kbd>
			</div>

			<h1 class="report-title">{ reporte.Titulo }</h1>

			<div class="report-meta-info">
				<span>Publicado en <strong>Tandil</strong></span>
				<span>•</span>
				<span>Lectura aprox. 2 min</span>
			</div>
		</header>

		if reporte.Imagen.Valid && reporte.Imagen.String != "" {
			<figure class="report-figure">
				<img 
					src={ reporte.Imagen.String } 
					alt={ reporte.Titulo }
					class="report-image"
				/>
				<figcaption class="report-caption">
					Fotografía adjunta al reporte original.
				</figcaption>
			</figure>
		}

		if reporte.Descripcion.Valid {
			<section class="report-body">
				for i, parrafo := range strings.Split(reporte.Descripcion.String, "\n\n") {
					if strings.TrimSpace(parrafo) != "" {
						if i == 0 {
							<p class="report-lead-paragraph">{ parrafo }</p>
						} else {
							<p>{ parrafo }</p>
						}
					}
				}
			</section>
		}

		<hr class="report-divider" />
		
		<footer class="report-footer">
			<a href="/" role="button" class="secondary outline btn-auto-width">
				← Volver al listado
			</a>
			<button class="contrast outline btn-auto-width" onclick="window.print()">
				Imprimir reporte
			</button>
		</footer>

	</article>
}