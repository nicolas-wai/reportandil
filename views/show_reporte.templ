package views

import db "reportandil/db/sqlc"

templ ReportPage(reporte db.Reporte, username string, statusCode int) {
	if statusCode >= 400 {
		@Layout("Reportandil - Error", username) {
			<div class="grid">
				@ReportErrorCard(statusCode)
			</div>
		}
	} else {
		@Layout("Reportandil - " + reporte.Titulo, username) {
			<div class="grid">
				@ReportCard(reporte)
			</div>
		}
	}
}

